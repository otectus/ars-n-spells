    {
      "key": "Resonance System.resonance_threshold",
      "field": "RESONANCE_THRESHOLD",
      "default": "0.95",
      "arguments": [
        "0.0",
        "1.0"
      ],
      "description": "Mana fraction at or above which resonance applies (0.95 = 95% full). The bonus itself still scales with how full the pool is; this only gates whether it applies at all. The default 0.95 matches the Forge variant. Set 0.0 to leave the gate open. Existing saved values are preserved.",
      "runtime_references": [
        "src/main/java/com/otectus/arsnspells/augmentation/ResonanceManager.java"
      ],
      "direct_test_references": []
    },
    {
      "key": "Resonance System.resonance_duration",
      "field": "RESONANCE_DURATION",
      "default": "100",
      "arguments": [
        "0",
        "1200"
      ],
      "description": "How long resonance keeps applying after the pool drops below resonance_threshold, in ticks (20 = 1 second). This is what makes a raised threshold playable: spending mana to cast necessarily drops you below it, so without a linger the bonus would switch off on the very cast that earned it. Has no effect while resonance_threshold is 0. Resolution is the recompute interval (40 ticks), so the effective linger is this value give or take one interval.",
      "runtime_references": [
        "src/main/java/com/otectus/arsnspells/augmentation/ResonanceManager.java"
      ],
      "direct_test_references": []
    },
