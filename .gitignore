dependencies/
mods/
io/
/com/
gradle-8.12/
gradle-8.12-bin.zip
*.jar
!gradle/wrapper/gradle-wrapper.jar

# Root META-INF (build artifact, not src/main/resources one)
/META-INF/

# Misc
nul
$null
*.log
